{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/manifest.schema.json",
  "schema_version": 3,
  "id": "chase.rs",
  "name": "追剧管家",
  "version": "0.1.18",
  "description": "小时级对齐「订阅池里的剧集订阅」与「Emby 已有集数」：只对可解析的条目做只增 PATCH total_episodes，并产出追剧日历与当天一次的日报；减方向只给建议，从不写。已核实无缺口的条目在 5 小时窗口内复用缓存，不重复探测 Emby。每次 PATCH 前后落任务检查点，中断恢复先查订阅池里该条目的真实集数，已确认写到位才记 complete、确认没写才 resume、核对不上记 attention（整点入口把 attention 收敛为 resume，靠只增守卫保证重跑不重复写）。界面按统一设计稿重绘：指标瓦片、徽标胶囊、双栏看板与移动端单栏适配。",
  "author": "congyoubanmian",
  "homepage": "https://github.com/congyoubanmian/dian115-plugins",
  "requires": {
    "api": "3.5"
  },
  "icon": "icon.svg",
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "追剧管家",
    "order": 40
  },
  "jobs": [
    {
      "id": "align",
      "entry": "jobs/align.js",
      "handler": "run",
      "recover": "recover",
      "title": "整点对齐订阅集数",
      "default_schedule": "0 * * * *",
      "timeout_seconds": 600
    },
    {
      "id": "align-now",
      "entry": "jobs/align-now.js",
      "handler": "run",
      "recover": "recover",
      "title": "立即对齐（限量）",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "refresh",
      "entry": "jobs/refresh.js",
      "handler": "run",
      "recover": "recover",
      "title": "刷新界面计数",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "probe-dump",
      "entry": "jobs/probe-dump.js",
      "handler": "run",
      "recover": "recover",
      "title": "探测诊断",
      "queue": false,
      "timeout_seconds": 300
    }
  ],
  "declared_usage": {
    "apis": [
      "GET /api/subscribe/pool/intents",
      "PATCH /api/subscribe/pool/intents/{id}/episodes",
      "GET /api/plugin-host/emby/instances",
      "GET /api/plugin-host/emby/episodes",
      "GET /api/subscribe/air-calendar",
      "GET /api/tmdb/tv/{id}",
      "GET/PUT/DELETE /api/extensions/v3/{id}/storage*"
    ],
    "notifications": true,
    "sites": [
      "image.tmdb.org"
    ],
    "risk": "每小时读取订阅池与 Emby 覆盖，并按只增原则 PATCH 订阅集数（从不缩小）；发送每日追剧报告通知；读写插件自有存储；界面从 image.tmdb.org 加载 TMDB 海报缩略图（后端只读宿主 TMDB 详情，不直接请求该站点）。不触碰宿主文件。"
  }
}
