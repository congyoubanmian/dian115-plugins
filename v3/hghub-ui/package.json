{
  "name": "hghub-plugin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "黄果短剧 DIAN115 v3 插件前端（React 应用构建源，产物输出到 ../hghub/ui）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-ui.mjs --verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "hls.js": "1.6.19",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
