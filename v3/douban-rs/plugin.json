{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/manifest.schema.json",
  "schema_version": 3,
  "id": "douban.rs",
  "name": "豆瓣中心（Rust 版）",
  "version": "1.1.4",
  "description": "豆瓣榜单抓取 + 黑名单过滤 + 观察队列 + 聚合订阅；按宿主新规约不再读取 CookieCloud；登录态由用户手动粘贴浏览器里的豆瓣 Cookie 提供，自动追订「我的想看」；TMDB 匹配失败时用豆瓣详情（原名/又名）回退重搜；支持最低评分/年份/地区订阅过滤与「已删除不重订」墓碑集。旧 schema 1 WASM 插件（plugins/douban-rs 0.2.4）的 v3 迁移版；页面提供榜单海报墙、观察队列/我的想看、历史日志与设置。",
  "author": "congyoubanmian",
  "homepage": "https://github.com/congyoubanmian/dian115-plugins",
  "requires": {
    "api": "3.5"
  },
  "icon": "icon.svg",
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "豆瓣中心",
    "order": 30
  },
  "jobs": [
    {
      "id": "refresh-charts",
      "entry": "jobs/refresh-charts.js",
      "handler": "run",
      "recover": "recover",
      "title": "定时刷新榜单",
      "default_schedule": "0 */2 * * *",
      "timeout_seconds": 900
    },
    {
      "id": "wish-sync",
      "entry": "jobs/wish-sync.js",
      "handler": "run",
      "recover": "recover",
      "title": "想看同步与到期订阅",
      "interval_seconds": 1800,
      "timeout_seconds": 1800
    },
    {
      "id": "refresh",
      "entry": "jobs/refresh.js",
      "handler": "run",
      "recover": "recover",
      "title": "立即刷新榜单",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "wish-sync-now",
      "entry": "jobs/wish-sync-now.js",
      "handler": "run",
      "recover": "recover",
      "title": "立即同步想看",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "subscribe",
      "entry": "jobs/subscribe.js",
      "handler": "run",
      "recover": "recover",
      "title": "订阅榜单条目",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "subscribe-now",
      "entry": "jobs/subscribe-now.js",
      "handler": "run",
      "recover": "recover",
      "title": "立即订阅队列条目",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "get-poster",
      "entry": "jobs/get-poster.js",
      "handler": "run",
      "recover": "recover",
      "title": "获取海报",
      "queue": false,
      "timeout_seconds": 120
    },
    {
      "id": "send-test",
      "entry": "jobs/send-test.js",
      "handler": "run",
      "recover": "recover",
      "title": "通知自检",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "observe-remove",
      "entry": "jobs/observe-remove.js",
      "handler": "run",
      "recover": "recover",
      "title": "移出观察队列",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "blacklist-add",
      "entry": "jobs/blacklist-add.js",
      "handler": "run",
      "recover": "recover",
      "title": "添加黑名单关键词",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "blacklist-remove",
      "entry": "jobs/blacklist-remove.js",
      "handler": "run",
      "recover": "recover",
      "title": "移除黑名单关键词",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "settings-update",
      "entry": "jobs/settings-update.js",
      "handler": "run",
      "recover": "recover",
      "title": "保存设置",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "archive",
      "entry": "jobs/archive.js",
      "handler": "run",
      "recover": "recover",
      "title": "归档历史与日志",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "open-source",
      "entry": "jobs/open-source.js",
      "handler": "run",
      "recover": "recover",
      "title": "打开豆瓣来源",
      "queue": false,
      "timeout_seconds": 60
    },
    {
      "id": "no-resub-clear",
      "entry": "jobs/no-resub-clear.js",
      "handler": "run",
      "recover": "recover",
      "title": "清除重订限制",
      "queue": false,
      "timeout_seconds": 60
    }
  ],
  "declared_usage": {
    "apis": [
      "GET/PUT/DELETE /api/extensions/v3/{id}/storage*",
      "GET /api/extensions/v3/{id}/settings",
      "POST /api/extensions/v3/{id}/notify",
      "POST /api/extensions/v3/{id}/http",
      "POST /api/extensions/v3/{id}/jobs/{job}",
      "GET /api/tmdb/search",
      "GET/POST /api/subscribe/pool/intents",
      "GET /api/subscribe/records"
    ],
    "sites": [
      "movie.douban.com（榜单抓取：j/search_subjects、/chart、/cinema/later/、j/subject_suggest）",
      "m.douban.com（想看列表与条目详情：rexxar api v2）",
      "*.doubanio.com（豆瓣海报 CDN，需带豆瓣 Referer 防盗链）"
    ],
    "notifications": true,
    "risk": "定期抓取豆瓣榜单与想看列表，按黑名单/过滤器入观察队列；到期条目经 TMDB 匹配（失配时回查豆瓣详情重搜）后创建宿主聚合订阅（宿主负责检索并投递 115 离线）；登录态只来自用户手动粘贴的豆瓣 Cookie（不读取 CookieCloud）；订阅结果发送通知。不写宿主文件，不触碰 115 账号。"
  }
}
