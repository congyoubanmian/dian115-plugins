{
  "schema_version": 3,
  "id": "avdb.lite",
  "name": "AVDB Lite",
  "version": "0.4.17",
  "author": "congyoubanmian",
  "description": "X1080X 的「無碼BT」「有碼BT」板块采集、文章浏览与一键 115 磁力离线。游客身份就能拿到这两个板块的下载地址，不需要账号。站点有 Cloudflare，过盾交给同机 Docker 里的 FlareSolverr（按插件介绍里的 compose 起一个容器即可，插件页面有「检查环境」按钮一键确认）；插件只负责解析、展示和把磁力送进 115 离线。",
  "requires": {
    "api": "3.11"
  },
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "AVDB Lite",
    "order": 50
  },
  "jobs": [
    {
      "id": "crawl-x1080x",
      "entry": "jobs/crawl-x1080x.js",
      "handler": "run",
      "recover": "recover",
      "title": "抓取 X1080X",
      "timeout_seconds": 900,
      "default_schedule": "*/30 * * * *",
      "allow_overlap": false
    },
    {
      "id": "sync-115",
      "entry": "jobs/sync-115.js",
      "handler": "run",
      "recover": "recover",
      "title": "同步 115 离线状态",
      "queue": false,
      "timeout_seconds": 180
    }
  ],
  "declared_usage": {
    "purpose": "通过 FlareSolverr 过 Cloudflare 后，以游客身份抓取 X1080X 的「無碼BT」「有碼BT」板块文章，展示磁力/ED2K，并把选中的磁力提交到 115 离线下载。游客即可见这两个板块的下载地址，不需要账号密码。",
    "sites": [
      "1080xin.com",
      "1080xin.vip"
    ],
    "apis": [
      "/api/115/accounts/options",
      "/api/115/offline/add",
      "/api/115/offline/download-path",
      "/api/115/offline/tasks",
      "/api/115/browse-dirs",
      "GET /api/extensions/v3/{id}/runs",
      "POST /api/extensions/v3/{id}/runs/{run}/cancel"
    ],
    "paths": "仅插件自有 data/files；不读写宿主文件。",
    "notifications": "当前版本不发送通知。"
  }
}