{
  "schema_version": 1,
  "repository": {
    "id": "congyoubanmian-dian115-plugins",
    "name": "dian115-plugins 插件仓库",
    "homepage": "https://github.com/congyoubanmian/dian115-plugins"
  },
  "plugins": [
    {
      "id": "douban.center",
      "name": "豆瓣中心",
      "version": "0.2.8",
      "description": "周期抓取豆瓣榜单，黑名单过滤后经观察队列自动创建 DIAN115 聚合订阅，并记录订阅历史与统计。 (WASM 运行时版, 兼容无 seccomp 内核如群晖4.4)",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/douban-center-wasm",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/v0.2.8/douban.center-0.2.8.d115p",
      "sha256": "e648fc5468fd39e4cb6948e2b8d503169a441cf6ac0fd4f4c4d7ce5788ffaf8c",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/tmdb/search",
            "reason": "把豆瓣榜单条目匹配到 TMDB 元数据（tmdb_id/类型/年份/海报）以创建聚合订阅"
          },
          {
            "method": "GET",
            "path": "/api/tmdb/movie/:id",
            "reason": "读取电影详情补充订阅信息"
          },
          {
            "method": "GET",
            "path": "/api/tmdb/tv/:id",
            "reason": "读取剧集详情补充订阅信息"
          },
          {
            "method": "POST",
            "path": "/api/subscribe/pool/intents",
            "reason": "为通过观察期的豆瓣条目创建聚合订阅（宿主负责检索并投递 115 离线）"
          },
          {
            "method": "GET",
            "path": "/api/subscribe/pool/intents",
            "reason": "查询已创建聚合订阅，用于去重与状态跟踪"
          },
          {
            "method": "GET",
            "path": "/api/subscribe/records",
            "reason": "读取订阅记录，用于订阅历史与统计"
          },
          {
            "method": "POST",
            "path": "/api/notifications/plugin",
            "reason": "订阅成功/失败时推送 Telegram 通知"
          },
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "读取配置镜像，便于跨端同步与排查"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "保存配置镜像"
          }
        ],
        "network": [
          {
            "origin": "https://movie.douban.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣榜单（chart、coming、search_subjects、subject_suggest）"
          },
          {
            "origin": "https://m.douban.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "豆瓣移动端 rexxar API，按 subject id 取口碑榜海报"
          },
          {
            "origin": "https://img1.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图（防盗链需带豆瓣 Referer）"
          },
          {
            "origin": "https://img2.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img3.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img4.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img5.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img6.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img7.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img8.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          },
          {
            "origin": "https://img9.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图"
          }
        ]
      },
      "tags": [
        "douban",
        "automation",
        "subscribe"
      ],
      "icon_url": "icons/douban.center.svg"
    },
    {
      "id": "music.dl",
      "name": "音乐下载",
      "version": "0.1.9",
      "description": "聚合网易云/QQ/酷狗音乐搜索下载，SVIP 音质自选，下载后经 CD2 写入 115 音乐目录自动入库整理。需要本机 music-agent sidecar 服务。",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/dian115-plugins",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/music-dl-v0.1.9/music.dl-0.1.9.d115p",
      "sha256": "5d65c490906a7cc5a04344c57fd98fdd7af1866324d7a137a094faeb8969d417",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [],
        "network": [
          {
            "origin": "http://127.0.0.1:8791",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "调用本机 music-agent 服务：扫码登录、音乐搜索、提交下载任务（下载在本机完成并经 CD2 写入 115）"
          }
        ]
      },
      "tags": [
        "music",
        "netease",
        "qq",
        "kugou",
        "download"
      ],
      "icon_url": "icons/music.dl.svg"
    }
  ]
