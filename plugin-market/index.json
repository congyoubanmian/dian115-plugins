    {
      "id": "music.dl",
      "name": "音乐下载",
      "version": "0.2.2",
      "description": "聚合网易云/QQ/酷狗音乐搜索下载，SVIP 音质自选，下载后经 CD2 写入 115 音乐目录自动入库整理。需要本机 music-agent sidecar 服务。",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/dian115-plugins",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/music-dl-v0.2.2/music.dl-0.2.2.d115p",
      "sha256": "2b06a4337cf65e10fc94329b61abc00f6686a75253975ff52ca04c0f6ce7d3d8",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [],
        "network": [
          {
            "origin": "http://127.0.0.1:8791",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "调用本机 music-agent 服务：扫码登录、音乐搜索、提交下载任务（下载在本机完成并经 CD2 写入 115）"
          }
        ]
      },
      "tags": [
        "music",
        "netease",
        "qq",
        "kugou",
        "download"
      ],
      "icon_url": "icons/music.dl.svg"
    },
    {
      "id": "music.rs",
      "name": "音乐下载（Rust 版）",
      "version": "0.3.6",
      "description": "网易云/QQ 音乐扫码登录、搜索与音质自选取链；无 sidecar，由宿主代理下载（本地暂存 → CD2 入库），任务状态落 KV 队列并支持 Telegram 回调重试。",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/dian115-plugins",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/music-rs-v0.3.6/music.rs-0.3.6.d115p",
      "sha256": "828bc07bb680847d31bebab2553546f9a3a5f1b6ae52e4ff5dd786b18b6d6a65",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox",
        "memory_mb": 128
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/plugin-host/files/roots",
            "reason": "列出宿主可访问的文件根（本地暂存目录与 CD2 音乐目录），供下载落点选择"
          },
          {
            "method": "GET",
            "path": "/api/plugin-host/files/entries",
            "reason": "浏览暂存目录与音乐目录条目，确认下载产物是否已落盘/入库"
          },
          {
            "method": "POST",
            "path": "/api/plugin-host/files/downloads",
            "reason": "让宿主代下载：把网易云/QQ 直链下载到本地暂存目录（无 sidecar 的第一段）"
          },
          {
            "method": "POST",
            "path": "/api/plugin-host/files/directories",
            "reason": "首次 pump 时在本地可写根下自动创建暂存目录"
          },
          {
            "method": "GET",
            "path": "/api/plugin-host/jobs/:job_ref",
            "reason": "轮询宿主代下载任务的进度与结果，推进 KV 任务队列"
          },
          {
            "method": "POST",
            "path": "/api/local-files/rename",
            "reason": "把 <短id>.part 暂存文件改名为最终曲名后再复制进目标目录"
          },
          {
            "method": "POST",
            "path": "/api/local-files/copy",
            "reason": "把暂存完成的音频复制进 CD2 挂载的音乐目录（第二段），由 CD2 负责入库整理"
          },
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "读取状态文档（任务队列/登录会话/设置），带 ETag 用于乐观锁"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "写入状态文档（If-Match 乐观锁 + 幂等键）"
          },
          {
            "method": "POST",
            "path": "/api/notifications/plugin",
            "reason": "下载尝试用尽失败时推送错误通知（标题含歌名，带 retry:<短id> 重试按钮）"
          }
        ],
        "network": [
          {
            "origin": "https://music.163.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "网易云搜索（POST /api/cloudsearch/pc）与扫码登录页（music.163.com/login?codekey=，由用户手机扫描）"
          },
          {
            "origin": "https://interface.music.163.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "网易云扫码登录：取 unikey（/api/login/qrcode/unikey）与轮询登录态（/api/login/qrcode/client/login）"
          },
          {
            "origin": "https://interface3.music.163.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "网易云 eapi 取链（/eapi/song/enhance/player/url/v1），按所选音质向下逐级尝试"
          },
          {
            "origin": "https://ssl.ptlogin2.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "QQ 扫码登录：ptqrshow 取二维码、ptqrlogin 轮询扫码结果与回跳地址"
          },
          {
            "origin": "https://open.weixin.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "微信扫码登录：connect/qrconnect 取登录页与 connect/qrcode/<uuid> 二维码图片"
          },
          {
            "origin": "https://lp.open.weixin.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "微信扫码轮询（connect/l/qrconnect）：拿 wx_errcode / wx_code，再用 code 换 QQ 音乐 cookie"
          },
          {
            "origin": "https://u.y.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "QQ 音乐核心接口（cgi-bin/musicu.fcg）：微信 code 换 cookie 与歌曲取链（music.vkey.GetVkey）"
          },
          {
            "origin": "https://c.y.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "QQ 音乐搜索（soso/fcgi-bin/search_for_qq_cp）"
          },
          {
            "origin": "https://graph.qq.com",
            "methods": [
              "GET",
              "POST"
            ],
            "proxy_mode": "direct",
            "reason": "QQ 登录重定向链落点（oauth2.0/login_jump）：qqPollQR 成功后最多 8 跳跟随回跳、收集 QQ 音乐 cookie"
          },
          {
            "origin": "http://127.0.0.1:8088",
            "methods": [
              "GET"
            ],
            "proxy_mode": "direct",
            "reason": "本机 CookieCloud 服务: 拉取加密同步数据解出网易云/QQ 登录 cookie"
          }
        ]
      },
      "tags": [
        "music",
        "netease",
        "qq",
        "rust",
        "download"
      ],
      "icon_url": "icons/music.rs.svg"
    }
  ]
