  "plugins": [
    {
      "id": "chase.rs",
      "name": "追剧管家（Rust 版）",
      "version": "0.1.3",
      "description": "小时级对齐「订阅池里的剧集订阅」与「Emby 已有集数」：只对可解析的条目做只增 PATCH total_episodes，并产出追剧日历与当天一次的 Telegram 日报；减方向只给建议，从不写。",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/dian115-plugins",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/chase-v0.1.3/chase.rs-0.1.3.d115p",
      "sha256": "4c80fd79de21f0ed6e64bd39d5a4910c8574a5c7762cb557343be0e688128678",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/subscribe/pool/intents",
            "reason": "读取订阅池的剧集订阅（media_type=tv），作为「应有多少集」的已知值来源"
          },
          {
            "method": "PATCH",
            "path": "/api/subscribe/pool/intents/:id/episodes",
            "reason": "把某一季的 total_episodes 抬到与 Emby 已有集数/TMDB 集数一致（只增，绝不缩小）"
          },
          {
            "method": "GET",
            "path": "/api/plugin-host/emby/instances",
            "reason": "列出 Emby 实例，选出默认或用户指定的实例来查询覆盖"
          },
          {
            "method": "GET",
            "path": "/api/plugin-host/emby/episodes",
            "reason": "查询该剧该季在 Emby 已有的集号列表（缺集判定的依据）"
          },
          {
            "method": "GET",
            "path": "/api/subscribe/air-calendar",
            "reason": "读取追剧日历，生成未来若干天的播出安排与日报的「今日播出」段"
          },
          {
            "method": "GET",
            "path": "/api/tmdb/tv/:id",
            "reason": "读取 TMDB 剧集详情里该季的 episode_count，作为补订的目标上限"
          },
          {
            "method": "POST",
            "path": "/api/notifications/plugin",
            "reason": "投递每个自然日至多一次的追剧日报（带去重键，无交互按钮）"
          },
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "读取本插件自己的状态文档（state 单键）：设置、上一轮结果与诊断"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "写回状态文档（带 ETag If-Match 乐观锁与唯一幂等键）"
          }
        ],
        "network": []
      },
      "tags": [
        "emby",
        "subscribe",
        "align",
        "automation"
      ],
      "icon_url": "icons/chase.rs.svg"
    },
    {
      "id": "douban.rs",
      "name": "豆瓣中心（Rust 版）",
      "version": "0.2.2",
      "description": "豆瓣榜单抓取 + 黑名单过滤 + 观察队列 + 聚合订阅；支持 CookieCloud 同步浏览器豆瓣登录态，自动追订「我的想看」。",
      "author": "congyoubanmian",
      "homepage": "https://github.com/congyoubanmian/douban-center-wasm",
      "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/rs-v0.2.2/douban.rs-0.2.2.d115p",
      "sha256": "9fc84559d32f25783ea23bd9f249508bf57286597ff506bdeb48665e5e6f5aa9",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "method": "GET",
            "path": "/api/tmdb/search",
            "reason": "把豆瓣榜单条目匹配到 TMDB 元数据（tmdb_id/类型/年份/海报）以创建聚合订阅"
          },
          {
            "method": "GET",
            "path": "/api/tmdb/movie/:id",
            "reason": "读取电影详情补充订阅信息"
          },
          {
            "method": "GET",
            "path": "/api/tmdb/tv/:id",
            "reason": "读取剧集详情补充订阅信息"
          },
          {
            "method": "POST",
            "path": "/api/subscribe/pool/intents",
            "reason": "为通过观察期的豆瓣条目创建聚合订阅（宿主负责检索并投递 115 离线）"
          },
          {
            "method": "GET",
            "path": "/api/subscribe/pool/intents",
            "reason": "查询已创建聚合订阅，用于去重与状态跟踪"
          },
          {
            "method": "GET",
            "path": "/api/subscribe/records",
            "reason": "读取订阅记录，用于订阅历史与统计"
          },
          {
            "method": "POST",
            "path": "/api/notifications/plugin",
            "reason": "订阅成功/失败时推送 Telegram 通知"
          },
          {
            "method": "GET",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "读取配置镜像，便于跨端同步与排查"
          },
          {
            "method": "PUT",
            "path": "/api/plugin-runtime/storage/:key",
            "reason": "保存配置镜像"
          }
        ],
        "network": [
          {
            "origin": "https://movie.douban.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣榜单（chart、coming、search_subjects、subject_suggest）"
          },
          {
            "origin": "https://m.douban.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "豆瓣移动端 rexxar API，按 subject id 取口碑榜海报"
          },
          {
            "origin": "https://img1.doubanio.com",
            "methods": [
              "GET"
            ],
            "proxy_mode": "system",
            "reason": "抓取豆瓣海报缩略图（防盗链需带豆瓣 Referer）"
          },
          {
