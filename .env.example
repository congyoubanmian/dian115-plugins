# 开发者实例凭据（复制成 .env.local 后填写；.env.local 已被 .gitignore 忽略，勿提交）
#
# DIAN115_URL —— 电脑可访问的 DIAN115 地址（不带尾斜杠）。
#   本机实例：http://127.0.0.1:8095
#   局域网实例：http://192.168.x.x:8095
#   注意：MCP 签发工具在哪台机器上跑，地址就得是那台机器可达的。
#
# DIAN115_API_KEY —— 宿主「系统设置」里的 OpenAPI Key（编译 MCP 用它鉴权）。
#   只放在本机 .env.local 或 CI secret（DIAN115_API_KEY）里，不要提交、不要贴进聊天。
#
# 可选：
# DIAN115_ACCOUNT_ID —— 选定的癫影账号 id（多账号时必填；正式署名取该会员昵称）
# DIAN115_COOKIE —— 若某些接口只认登录会话，填 dian115_token=<值>
# DIAN115_PLUGIN —— 要验证的插件 id，默认 douban.rs

DIAN115_URL=http://127.0.0.1:8095
DIAN115_API_KEY=
DIAN115_ACCOUNT_ID=
DIAN115_COOKIE=
DIAN115_PLUGIN=douban.rs
