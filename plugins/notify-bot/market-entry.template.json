{
  "id": "notify.bot",
  "name": "通知机器人",
  "version": "0.1.1",
  "description": "多平台消息通知：企业微信、飞书、Server酱、QQ。支持代理地址、多配置、自定义消息模板。",
  "author": "congyoubanmian",
  "homepage": "https://github.com/congyoubanmian/dian115-plugins",
  "package_url": "https://example.invalid/notify.bot-0.1.1.d115p",
  "sha256": "8f9b51d938deb0aea5e376fc0fbea326aa65acf7ed863397312edb96e0c831eb",
  "runtime": {
    "kind": "wasm",
    "protocol": "dian115:wasm@1",
    "autostart": true,
    "trust_level": "wasm-sandbox"
  },
  "permissions": {
    "apis": [],
    "network": [
      {
        "origin": "https://qyapi.weixin.qq.com",
        "methods": [
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "企业微信 webhook 推送"
      },
      {
        "origin": "https://open.feishu.cn",
        "methods": [
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "飞书 webhook 推送"
      },
      {
        "origin": "https://sctapi.ftqq.com",
        "methods": [
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "Server酱推送"
      },
      {
        "origin": "https://qmsg.zber.com",
        "methods": [
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "Qmsg酱 QQ 推送"
      },
      {
        "origin": "http://127.0.0.1:8791",
        "methods": [
          "GET",
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "调用 music-agent sidecar"
      }
    ]
  },
  "tags": [
    "notify",
    "webhook",
    "wecom",
    "feishu",
    "serverchan"
  ]
}
