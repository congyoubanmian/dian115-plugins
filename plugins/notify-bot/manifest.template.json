{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "notify.bot",
  "name": "通知机器人",
  "version": "0.1.0",
  "description": "多平台消息通知：企业微信、飞书、Server酱、QQ。支持代理地址、多配置、自定义消息模板。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "congyoubanmian",
    "key_id": "ed25519:REPLACED_BY_PACKAGER",
    "url": "https://github.com/congyoubanmian"
  },
  "compatibility": {
    "dian115": ">=3.8.51 <5.0.0",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 60000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 60000,
    "background_timeout_ms": 600000,
    "memory_mb": 256,
    "max_concurrency": 2,
    "restart_policy": "on-failure"
  },
  "permissions": {
    "apis": [],
    "network": [
      { "origin": "https://qyapi.weixin.qq.com", "methods": ["POST"], "proxy_mode": "direct", "reason": "企业微信 webhook 推送" },
      { "origin": "https://open.feishu.cn", "methods": ["POST"], "proxy_mode": "direct", "reason": "飞书 webhook 推送" },
      { "origin": "https://sctapi.ftqq.com", "methods": ["POST"], "proxy_mode": "direct", "reason": "Server酱推送" },
      { "origin": "https://qmsg.zber.com", "methods": ["POST"], "proxy_mode": "direct", "reason": "Qmsg酱 QQ 推送" },
      { "origin": "http://127.0.0.1:8791", "methods": ["GET", "POST"], "proxy_mode": "direct", "reason": "调用 music-agent sidecar" }
    ]
  },
  "jobs": [],
  "homepage": "https://github.com/congyoubanmian/dian115-plugins",
  "repository": "https://github.com/congyoubanmian/dian115-plugins",
  "license": "MIT",
  "tags": ["notify", "webhook", "wecom", "feishu", "serverchan"]
}
