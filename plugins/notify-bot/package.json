{
  "name": "notify-bot-plugin",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "vue-tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:ui && npm run build:wasm",
    "check": "node scripts/check.mjs",
    "test:runtime": "go test runtime/notify.go runtime/main.go runtime/notify_test.go",
    "test:wasm": "node scripts/test-runtime-wasm.mjs",
    "market": "node scripts/build-market-index.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build && npm run package"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.16.0",
    "naive-ui": "^2.38.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.16.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "naive-ui": "^2.38.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0",
    "yazl": "^3.3.1"
  }
}
