{
  "id": "douban.rs",
  "name": "豆瓣中心（Rust 版）",
  "version": "0.2.7",
  "description": "豆瓣榜单抓取 + 黑名单过滤 + 观察队列 + 聚合订阅；支持 CookieCloud 同步浏览器豆瓣登录态，自动追订「我的想看」。界面按统一设计稿重绘：榜单海报卡、观察队列/我的想看双栏、不再订阅名单条与移动端单栏适配。",
  "author": "congyoubanmian",
  "homepage": "https://github.com/congyoubanmian/douban-center-wasm",
  "package_url": "https://github.com/congyoubanmian/dian115-plugins/releases/download/rs-v0.2.7/douban.rs-0.2.7.d115p",
  "sha256": "149c648cb8887ff290777245abfa21b177756997b77773c79c1b67791b945722",
  "runtime": {
    "kind": "wasm",
    "protocol": "dian115:wasm@1",
    "autostart": true,
    "trust_level": "wasm-sandbox"
  },
  "permissions": {
    "apis": [
      {
        "method": "GET",
        "path": "/api/tmdb/search",
        "reason": "把豆瓣榜单条目匹配到 TMDB 元数据（tmdb_id/类型/年份/海报）以创建聚合订阅"
      },
      {
        "method": "POST",
        "path": "/api/subscribe/pool/intents",
        "reason": "为通过观察期的豆瓣条目创建聚合订阅（宿主负责检索并投递 115 离线）"
      },
      {
        "method": "GET",
        "path": "/api/subscribe/pool/intents",
        "reason": "查询已创建聚合订阅，用于去重与状态跟踪"
      },
      {
        "method": "POST",
        "path": "/api/notifications/plugin",
        "reason": "订阅成功/失败时推送 Telegram 通知"
      },
      {
        "method": "GET",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "读取配置镜像，便于跨端同步与排查"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "保存配置镜像"
      }
    ],
    "network": [
      {
        "origin": "https://movie.douban.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣榜单（chart、coming、search_subjects、subject_suggest）"
      },
      {
        "origin": "https://m.douban.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "豆瓣移动端 rexxar API，按 subject id 取口碑榜海报"
      },
      {
        "origin": "https://img1.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图（防盗链需带豆瓣 Referer）"
      },
      {
        "origin": "https://img2.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img3.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img4.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img5.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img6.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img7.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img8.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "https://img9.doubanio.com",
        "methods": [
          "GET"
        ],
        "proxy_mode": "system",
        "reason": "抓取豆瓣海报缩略图"
      },
      {
        "origin": "http://127.0.0.1:8088",
        "methods": [
          "GET"
        ],
        "proxy_mode": "direct",
        "reason": "本机 CookieCloud 服务：拉取加密同步数据解出豆瓣登录 cookie"
      }
    ]
  },
  "tags": [
    "douban",
    "automation",
    "subscribe"
  ]
}
