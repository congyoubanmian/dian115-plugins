{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "music.dl",
  "name": "音乐下载",
  "version": "0.1.1",
  "description": "聚合网易云/QQ/酷狗音乐搜索下载，SVIP 音质自选，下载后经 CD2 写入 115 音乐目录自动入库整理。需要本机 music-agent sidecar 服务。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "congyoubanmian",
    "key_id": "ed25519:REPLACED_BY_PACKAGER",
    "url": "https://github.com/congyoubanmian"
  },
  "compatibility": {
    "dian115": ">=3.8.51 <5.0.0",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 60000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 60000,
    "background_timeout_ms": 600000,
    "memory_mb": 256,
    "max_concurrency": 2,
    "restart_policy": "on-failure"
  },
  "permissions": {
    "apis": [],
    "network": [
      {
        "origin": "http://127.0.0.1:8791",
        "methods": [
          "GET",
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "调用本机 music-agent 服务：扫码登录、音乐搜索、提交下载任务（下载在本机完成并经 CD2 写入 115）"
      }
    ]
  },
  "jobs": [],
  "homepage": "https://github.com/congyoubanmian/dian115-plugins",
  "repository": "https://github.com/congyoubanmian/dian115-plugins",
  "license": "MIT",
  "tags": [
    "music",
    "netease",
    "qq",
    "kugou",
    "download"
  ],
  "ui": {
    "mode": "federation",
    "icon": "frontend/icon.svg",
    "federation": {
      "entry": "frontend/dist/assets/remoteEntry.js",
      "assets_root": "frontend/dist/assets",
      "module": "./AppPage"
    }
  }
}
