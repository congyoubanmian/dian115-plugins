[
  {
    "event": "library_organize_fail",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "button_interaction",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "❌ 整理失败{% if failure_count %}｜{{ failure_count }} 项{% endif %}",
        "desc": "🕐 {{ time_range or now }}"
      },
      "sub_title_text": "{% if failure_details %}⚠️ 失败详情：{{ failure_details }}{% elif error_message %}⚠️ {{ error_message }}{% elif message_text %}⚠️ {{ message_text }}{% else %}⚠️ 整理失败，请检查运行日志{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "失败项数",
          "value": "{{ failure_count or '未知' }}"
        },
        {
          "keyname": "目标路径",
          "value": "{{ target_path or '未提供' }}"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      },
      "button_list": [
        {
          "text": "重新整理",
          "type": 0,
          "key": "library_organize_retry",
          "style": 1
        },
        {
          "text": "打开115",
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "style": 4
        }
      ]
    }
  },
  {
    "event": "library_organize_skip",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "button_interaction",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "⏳ 整理跳过｜{{ show_name or title }}{% if season_episode %} · {{ season_episode }}{% endif %}",
        "desc": "🕐 {{ time_range or now }}"
      },
      "sub_title_text": "{% if skip_reason %}⏳ 跳过原因：{{ skip_reason }}{% elif wash_reason %}⏳ 跳过原因：{{ wash_reason }}{% else %}⏳ 整理已跳过{% endif %}{% if quality_comment %} · ✨ 待整理资源：{{ quality_comment }}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "来源文件",
          "value": "{{ source_path or '未提供' }}"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      },
      "button_list": [
        {
          "text": "重新整理",
          "type": 0,
          "key": "library_organize_retry",
          "style": 1
        },
        {
          "text": "打开115",
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "style": 4
        },
        {
          "text": "查看TMDB",
          "type": 1,
          "url": "https://www.themoviedb.org",
          "style": 4
        }
      ]
    }
  },
  {
    "event": "dian115_self_update",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "button_interaction",
