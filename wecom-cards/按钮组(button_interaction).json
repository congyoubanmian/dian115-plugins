      "main_title": {
        "title": "{% if update_success %}🆙 Dian115 更新成功{% else %}❌ Dian115 更新失败{% endif %}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if update_success %}✅ 自更新已完成并生效{% elif error_message %}⚠️ 原因：{{ error_message }}{% elif details %}📝 {{ details }}{% else %}⚠️ 更新未成功，请检查运行日志{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "当前版本",
          "value": "{{ current_version or '未知' }}"
        },
        {
          "keyname": "构建通道",
          "value": "{{ build_channel or '未知' }}{% if build_commit %} · {{ build_commit }}{% endif %}"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      },
      "button_list": [
        {
          "text": "重新更新",
          "type": 0,
          "key": "dian115_update_retry",
          "style": 1
        },
        {
          "text": "打开115",
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "style": 4
        }
      ]
    }
  },
  {
