  },
  {
    "event": "container_update_result",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "button_interaction",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "🖥️ 容器更新结果｜成功 {{ success_count }} · 失败 {{ failed_count }}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if details %}📋 明细：{{ details }}{% else %}📦 本次处理 {{ container_count or '未知' }} 个容器{% if failed_count %}，失败 {{ failed_count }} 个{% endif %}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "处理容器",
          "value": "{{ container_count or '未知' }} 个"
        },
        {
          "keyname": "成功",
          "value": "{{ success_count or 0 }}"
        },
        {
          "keyname": "失败",
          "value": "{{ failed_count or 0 }}"
        },
        {
          "keyname": "触发方式",
