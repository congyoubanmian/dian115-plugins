      },
      "button_list": [
        {
          "text": "重试更新",
          "type": 0,
          "key": "container_update_retry",
          "style": 1
        },
        {
          "text": "打开115",
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "style": 4
        }
      ]
    }
  }
