  {
    "event": "subscribe_added",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "text_notice",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "🏷️ 已添加订阅｜{{ title_year }}{% if season_episode %} · {{ season_episode }}{% endif %}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if media_type %}🎬 {{ media_type }}{% endif %}{% if channel %} · 📡 {{ channel }}{% endif %}{% if rating %} · ⭐ {{ rating }}{% endif %}{% if genres %} · {{ genres }}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "类型",
          "value": "{{ media_type or '—' }}"
        },
        {
          "keyname": "待补",
          "value": "{{ needed_episodes or '—' }}"
        },
        {
          "keyname": "渠道",
          "value": "{{ channel or '—' }}"
        },
        {
          "keyname": "评分",
          "value": "{% if rating %}⭐ {{ rating }}{% else %}—{% endif %}"
        }
      ],
      "jump_list": [
        {
          "type": 1,
          "url": "{% if tmdb_link %}{{ tmdb_link }}{% else %}https://www.themoviedb.org{% endif %}",
          "title": "TMDB 详情"
        },
        {
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "title": "打开 Dian115"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "{% if tmdb_link %}{{ tmdb_link }}{% else %}https://dian115.congyoubanmian.com{% endif %}"
      }
    }
  },
