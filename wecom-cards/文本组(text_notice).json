  {
    "event": "daily_statistics_report",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "text_notice",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "📊 每日运行统计｜{{ report_date }}",
        "desc": "{% if period_label %}📅 {{ period_label }}{% else %}🕐 {{ generated_at or now }}{% endif %}"
      },
      "sub_title_text": "{% if latest_media %}🎞 最新整理：{% for item in latest_media %}{{ item.title }}{% if item.episode %} {{ item.episode }}{% endif %} {% endfor %}{% else %}📈 当日运行统计已生成{% endif %}{% if signature %} · ✍️ {{ signature }}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "整理",
          "value": "{{ organized_count }}"
        },
        {
          "keyname": "新增",
          "value": "{{ new_count }}"
        },
        {
          "keyname": "洗版",
          "value": "{{ wash_count }}"
        },
        {
          "keyname": "转存",
          "value": "{{ transfer_count }}"
        },
        {
          "keyname": "离线",
          "value": "{{ offline_count }}"
        },
        {
          "keyname": "媒体库",
          "value": "{{ emby_media_total }}"
        }
      ],
      "jump_list": [
        {
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "title": "打开 Dian115"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      }
    }
  },
