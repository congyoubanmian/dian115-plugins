[
  {
    "event": "account_checkin",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "text_notice",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "🗓️ 115 签到{% if account_name %}｜{{ account_name }}{% endif %}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if status_message %}{{ status_emoji or '✅' }} {{ status_message }}{% else %}✅ 签到完成{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "本次积分",
          "value": "{% if points %}+{{ points }}{% else %}—{% endif %}"
        },
        {
          "keyname": "总积分",
          "value": "{{ total_points or '—' }}"
        },
        {
          "keyname": "本机累计",
          "value": "{% if checkin_count %}{{ checkin_count }} 次{% if checkin_points %} · {{ checkin_points }} 积分{% endif %}{% else %}—{% endif %}"
        }
      ],
      "jump_list": [
        {
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "title": "打开 Dian115"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      }
    }
  },
  {
    "event": "account_migration",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "text_notice",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "📦 多号云迁移{{ status_text }}{% if file_name %}｜{{ file_name }}{% endif %}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if error_message %}⚠️ {{ error_message }}{% else %}📊 成功 {{ success_count }} · 失败 {{ failed_count }}{% if skipped_count %} · 跳过 {{ skipped_count }}{% endif %}{% if target_path %} · 🎯 {{ target_path }}{% endif %}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "成功",
          "value": "{{ success_count }}"
        },
        {
          "keyname": "失败",
          "value": "{{ failed_count }}"
        },
        {
          "keyname": "跳过",
          "value": "{{ skipped_count or 0 }}"
        },
        {
          "keyname": "扫描",
          "value": "{{ scanned_count or '—' }}"
        },
        {
          "keyname": "秒传体积",
          "value": "{{ total_size or '—' }}"
        },
        {
          "keyname": "耗时",
          "value": "{{ elapsed or '—' }}"
        }
      ],
      "jump_list": [
        {
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "title": "打开 Dian115"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      }
    }
  },
  {
    "event": "account_cookie_invalid",
    "msgtype": "template_card",
    "template_card": {
      "card_type": "text_notice",
      "source": {
        "desc": "Dian115 媒体中心"
      },
      "main_title": {
        "title": "⚠️ 115 Cookie 失效{% if account_name %}｜{{ account_name }}{% endif %}",
        "desc": "🕐 {{ now }}"
      },
      "sub_title_text": "{% if status_message %}⚠️ {{ status_message }}{% else %}⚠️ Cookie 已失效，请重新登录 115 账号{% endif %}{% if details %} · 📝 {{ details }}{% endif %}",
      "horizontal_content_list": [
        {
          "keyname": "账号",
          "value": "{{ account_name or '未知账号' }}"
        },
        {
          "keyname": "状态",
          "value": "Cookie 失效"
        },
        {
          "keyname": "时间",
          "value": "{{ now }}"
        }
      ],
      "jump_list": [
        {
          "type": 1,
          "url": "https://dian115.congyoubanmian.com",
          "title": "重新登录"
        }
      ],
      "card_action": {
        "type": 1,
        "url": "https://dian115.congyoubanmian.com"
      }
    }
  },
